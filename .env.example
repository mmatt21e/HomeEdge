# Copy to `.env` and adjust. docker compose reads this automatically.
# NEVER commit your real .env.

# HTTP port published on the host.
HOMESTOCK_HTTP_PORT=8080

# ---- First-run administrator ----
HOMESTOCK_ADMIN_EMAIL=admin@homestock.local
# Set a strong password. If left blank, a random one is generated and printed to the
# container logs on first startup (docker compose logs homestock).
HOMESTOCK_ADMIN_PASSWORD=

# ---- Database ----
# Sqlite (default, zero-config) or Postgres.
HOMESTOCK_DB_PROVIDER=Sqlite
# For Sqlite the default connection is fine. For Postgres, enable the postgres profile and use:
# HOMESTOCK_DB_PROVIDER=Postgres
# HOMESTOCK_DB_CONNECTION=Host=postgres;Database=homestock;Username=homestock;Password=CHANGE_ME
# HOMESTOCK_POSTGRES_PASSWORD=CHANGE_ME

# ---- Future remote access ----
# Comma-separated trusted reverse-proxy IP(s). Leave blank for direct LAN access.
HOMESTOCK_TRUSTED_PROXY=
