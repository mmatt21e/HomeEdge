@page "/items/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using HomeStock.Web.Infrastructure
@inject IItemService ItemService
@inject IItemHistoryService HistoryService
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>@(_item?.Name ?? "Item") · HomeStock</PageTitle>

@if (_item is null)
{
    <LoadingIndicator />
}
else
{
    <div class="page-header">
        <div>
            <a href="/items" class="small text-secondary"><i class="bi bi-chevron-left"></i> Items</a>
            <h1 class="d-flex align-items-center gap-2">
                @_item.Name
                @if (_item.IsArchived) { <span class="badge text-bg-dark">Archived</span> }
            </h1>
        </div>
        <AuthorizeView Policy="@Roles.CanEditPolicy">
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="@($"/items/{Id}/edit")"><i class="bi bi-pencil"></i> Edit</a>
                @if (_item.IsArchived)
                {
                    <button class="btn btn-outline-secondary" @onclick="Restore"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" @onclick="Archive"><i class="bi bi-archive"></i> Archive</button>
                }
                <AuthorizeView Policy="@Roles.AdminPolicy" Context="admin">
                    <button class="btn btn-outline-danger" @onclick="Delete"><i class="bi bi-trash"></i></button>
                </AuthorizeView>
            </div>
        </AuthorizeView>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="panel mb-3">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <StatusBadge Status="_item.Status" />
                    <span class="badge text-bg-@DisplayHelpers.ConditionClass(_item.Condition)">@DisplayHelpers.Label(_item.Condition)</span>
                    <WarrantyBadge Expiry="_item.WarrantyExpiration" />
                    @foreach (var t in _item.Tags) { <span class="tag-chip">@t</span> }
                </div>
                @if (!string.IsNullOrWhiteSpace(_item.Description)) { <p>@_item.Description</p> }

                <dl class="row mb-0">
                    <Field Label="Category" Value="@_item.CategoryName" />
                    <Field Label="Subcategory" Value="@_item.Subcategory" />
                    <Field Label="Quantity" Value="@_item.Quantity.ToString()" />
                    <Field Label="Location" Value="@_item.LocationName" />
                    <Field Label="Container / bin" Value="@_item.Container" />
                    <Field Label="Manufacturer" Value="@_item.Manufacturer" />
                    <Field Label="Brand" Value="@_item.Brand" />
                    <Field Label="Model number" Value="@_item.ModelNumber" />
                    <Field Label="Serial number" Value="@_item.SerialNumber" />
                    <Field Label="Barcode / UPC" Value="@_item.Barcode" />
                    <Field Label="Purchase date" Value="@_item.PurchaseDate?.ToString("yyyy-MM-dd")" />
                    <Field Label="Purchased at" Value="@_item.PurchaseLocation" />
                    <Field Label="Purchase price" Value="@_item.PurchasePrice?.ToString("C2")" />
                    <Field Label="Estimated value" Value="@_item.EstimatedValue?.ToString("C2")" />
                    <Field Label="Warranty expires" Value="@_item.WarrantyExpiration?.ToString("yyyy-MM-dd")" />
                </dl>
                @if (!string.IsNullOrWhiteSpace(_item.Notes))
                {
                    <hr /><h3 class="h6">Notes</h3><p class="mb-0" style="white-space:pre-wrap;">@_item.Notes</p>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="panel">
                <h3 class="h6"><i class="bi bi-clock-history"></i> History</h3>
                @if (_history.Count == 0)
                {
                    <p class="text-secondary small mb-0">No history recorded.</p>
                }
                else
                {
                    <ul class="list-unstyled small mb-0">
                        @foreach (var h in _history)
                        {
                            <li class="mb-2">
                                <div><strong>@h.Action</strong> @h.Summary</div>
                                <div class="text-secondary">@h.Timestamp.ToLocalTime().ToString("g") @(string.IsNullOrEmpty(h.UserName) ? "" : $"· {h.UserName}")</div>
                            </li>
                        }
                    </ul>
                }
                <div class="text-secondary small mt-3">
                    Created @_item.CreatedAt.ToLocalTime().ToString("g")<br />
                    Updated @_item.UpdatedAt.ToLocalTime().ToString("g")
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter] public int Id { get; set; }
    private ItemDto? _item;
    private IReadOnlyList<ItemHistoryDto> _history = Array.Empty<ItemHistoryDto>();
    private ConfirmDialog _confirm = default!;

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Reload()
    {
        _item = await ItemService.GetAsync(Id);
        if (_item is null) { Nav.NavigateTo("/items"); return; }
        _history = await HistoryService.GetForItemAsync(Id);
    }

    private async Task Archive()
    {
        if (!await _confirm.ShowAsync("Archive item", $"Archive “{_item!.Name}”? It stays searchable under Archived.", "Archive", danger: false)) return;
        var r = await ItemService.ArchiveAsync(Id);
        if (r.Succeeded) { Toasts.Info("Item archived."); await Reload(); } else Toasts.Error(string.Join(" ", r.Errors));
    }

    private async Task Restore()
    {
        var r = await ItemService.RestoreAsync(Id);
        if (r.Succeeded) { Toasts.Success("Item restored."); await Reload(); } else Toasts.Error(string.Join(" ", r.Errors));
    }

    private async Task Delete()
    {
        if (!await _confirm.ShowAsync("Delete permanently", $"Permanently delete “{_item!.Name}”? This cannot be undone.", "Delete")) return;
        var r = await ItemService.DeleteAsync(Id);
        if (r.Succeeded) { Toasts.Success("Item deleted."); Nav.NavigateTo("/items"); } else Toasts.Error(string.Join(" ", r.Errors));
    }
}
