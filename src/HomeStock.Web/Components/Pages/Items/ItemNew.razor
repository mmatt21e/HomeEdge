@page "/items/new"
@attribute [Authorize(Policy = HomeStock.Domain.Enums.Roles.CanEditPolicy)]
@rendermode InteractiveServer
@inject IItemService ItemService
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>Add item · HomeStock</PageTitle>

<div class="page-header"><h1>Add item</h1></div>

<div class="panel">
    <ItemForm Model="_model" SubmitLabel="Create item" OnSubmit="Save" />
</div>

@code {
    [SupplyParameterFromQuery] public string? Barcode { get; set; }

    private readonly ItemEditModel _model = new();

    protected override void OnParametersSet()
    {
        // Prefill a scanned barcode when arriving from the Scan page.
        if (!string.IsNullOrWhiteSpace(Barcode) && string.IsNullOrEmpty(_model.Barcode))
            _model.Barcode = Barcode.Trim();
    }

    private async Task Save()
    {
        var result = await ItemService.CreateAsync(_model);
        if (!result.Succeeded)
        {
            Toasts.Error(string.Join(" ", result.Errors));
            return;
        }
        foreach (var w in result.Warnings) Toasts.Warning(w);
        Toasts.Success($"“{_model.Name}” added.");
        Nav.NavigateTo($"/items/{result.Value}");
    }
}
