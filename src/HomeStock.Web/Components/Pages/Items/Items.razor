@page "/items"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IItemService ItemService
@inject ICategoryService CategoryService
@inject ILocationService LocationService
@inject NavigationManager Nav

<PageTitle>Items · HomeStock</PageTitle>

<div class="page-header">
    <h1>Items</h1>
    <AuthorizeView Policy="@Roles.CanEditPolicy">
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" href="/items/from-photo"><i class="bi bi-camera"></i> Add from photo</a>
            <a class="btn btn-primary" href="/items/new"><i class="bi bi-plus-lg"></i> Add item</a>
        </div>
    </AuthorizeView>
</div>

<div class="filter-bar">
    <div class="input-group" style="max-width: 420px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input class="form-control" placeholder="Search…" value="@_query.Search"
               @onchange="e => ApplySearch(e.Value?.ToString())" />
    </div>

    <select class="form-select w-auto" @onchange="e => OnFilter(() => _query.CategoryId = ParseInt(e.Value))">
        <option value="">All categories</option>
        @foreach (var c in _categories)
        {
            <option value="@c.Id" selected="@(_query.CategoryId == c.Id)">@c.Name</option>
        }
    </select>

    <select class="form-select w-auto" @onchange="e => OnFilter(() => _query.LocationId = ParseInt(e.Value))">
        <option value="">All locations</option>
        @foreach (var l in _locations)
        {
            <option value="@l.Location.Id" selected="@(_query.LocationId == l.Location.Id)">@l.Path</option>
        }
    </select>

    <select class="form-select w-auto" @onchange="e => OnFilter(() => _query.Status = ParseEnum<ItemStatus>(e.Value))">
        <option value="">Any status</option>
        @foreach (var s in Enum.GetValues<ItemStatus>())
        {
            <option value="@s" selected="@(_query.Status == s)">@Infrastructure.DisplayHelpers.Label(s)</option>
        }
    </select>

    <select class="form-select w-auto" @onchange="e => OnFilter(() => _query.Warranty = ParseEnum<WarrantyState>(e.Value))">
        <option value="">Any warranty</option>
        <option value="@WarrantyState.Active" selected="@(_query.Warranty == WarrantyState.Active)">Under warranty</option>
        <option value="@WarrantyState.ExpiringSoon" selected="@(_query.Warranty == WarrantyState.ExpiringSoon)">Expiring soon</option>
        <option value="@WarrantyState.Expired" selected="@(_query.Warranty == WarrantyState.Expired)">Expired</option>
    </select>

    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="archivedChk" checked="@_query.OnlyArchived"
               @onchange="e => OnFilter(() => _query.OnlyArchived = (bool)e.Value!)" />
        <label class="form-check-label" for="archivedChk">Archived</label>
    </div>

    @if (HasActiveFilters)
    {
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters"><i class="bi bi-x-circle"></i> Clear</button>
    }
</div>

@if (_result is null)
{
    <LoadingIndicator />
}
else if (_result.TotalCount == 0)
{
    <EmptyState Icon="bi-box-seam" Title="No items match"
                Message="Try adjusting your search or filters, or add a new item.">
        <Action><a class="btn btn-primary" href="/items/new"><i class="bi bi-plus-lg"></i> Add item</a></Action>
    </EmptyState>
}
else
{
    <p class="text-secondary small">@_result.TotalCount item(s)</p>
    <div class="d-flex flex-column gap-2">
        @foreach (var item in _result.Items)
        {
            <ItemRow Item="item" />
        }
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav class="mt-3 d-flex justify-content-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasPrevious)" @onclick="() => GoToPage(_query.Page - 1)">
                <i class="bi bi-chevron-left"></i> Prev
            </button>
            <span class="align-self-center small">Page @_result.Page of @_result.TotalPages</span>
            <button class="btn btn-outline-secondary btn-sm" disabled="@(!_result.HasNext)" @onclick="() => GoToPage(_query.Page + 1)">
                Next <i class="bi bi-chevron-right"></i>
            </button>
        </nav>
    }
}

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public int? Category { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public int? LocationId { get; set; }
    [SupplyParameterFromQuery] public string? Warranty { get; set; }
    [SupplyParameterFromQuery(Name = "loaned")] public bool Loaned { get; set; }
    [SupplyParameterFromQuery(Name = "missingPhoto")] public bool MissingPhoto { get; set; }
    [SupplyParameterFromQuery(Name = "missingLocation")] public bool MissingLocation { get; set; }

    private ItemQuery _query = new();
    private PagedResult<ItemListDto>? _result;
    private IReadOnlyList<CategoryDto> _categories = Array.Empty<CategoryDto>();
    private IReadOnlyList<LocationTreeNode> _locations = Array.Empty<LocationTreeNode>();

    private bool HasActiveFilters => _query.Search is { Length: > 0 } || _query.CategoryId is not null
        || _query.LocationId is not null || _query.Status is not null || _query.Warranty is not null
        || _query.OnlyLoaned || _query.MissingPhoto || _query.MissingLocation || _query.OnlyArchived;

    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetAllAsync();
        _locations = await LocationService.GetTreeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _query = new ItemQuery
        {
            Search = Search,
            CategoryId = Category,
            LocationId = LocationId,
            Warranty = Enum.TryParse<WarrantyState>(Warranty, out var w) ? w : null,
            OnlyLoaned = Loaned,
            MissingPhoto = MissingPhoto,
            MissingLocation = MissingLocation,
            Page = _query.Page
        };
        await Load();
    }

    private async Task Load() => _result = await ItemService.SearchAsync(_query);

    private async Task ApplySearch(string? term)
    {
        _query.Search = term;
        _query.Page = 1;
        await Load();
    }

    private async Task OnFilter(Action mutate)
    {
        mutate();
        _query.Page = 1;
        await Load();
    }

    private async Task GoToPage(int page)
    {
        _query.Page = Math.Max(1, page);
        await Load();
    }

    private async Task ClearFilters()
    {
        _query = new ItemQuery();
        Nav.NavigateTo("/items");
        await Load();
    }

    private static int? ParseInt(object? v) => int.TryParse(v?.ToString(), out var i) ? i : null;
    private static T? ParseEnum<T>(object? v) where T : struct, Enum
        => Enum.TryParse<T>(v?.ToString(), out var e) ? e : null;
}
