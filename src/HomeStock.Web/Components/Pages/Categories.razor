@page "/categories"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICategoryService CategoryService
@inject ToastService Toasts

<PageTitle>Categories · HomeStock</PageTitle>

<div class="page-header">
    <h1>Categories</h1>
    <AuthorizeView Policy="@Roles.CanEditPolicy">
        <button class="btn btn-primary" @onclick="() => StartEdit(null)"><i class="bi bi-plus-lg"></i> New category</button>
    </AuthorizeView>
</div>

@if (_editing is not null)
{
    <div class="panel mb-3">
        <h3 class="h6">@(_editingId is null ? "New category" : "Edit category")</h3>
        <EditForm Model="_editing" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="_editing.Name" />
                    <ValidationMessage For="() => _editing.Name" class="field-error" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Description</label>
                    <InputText class="form-control" @bind-Value="_editing.Description" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Colour</label>
                    <InputText type="color" class="form-control form-control-color" @bind-Value="_editing.Color" />
                </div>
                <div class="col-6 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i></button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _editing = null">Cancel</button>
                </div>
            </div>
        </EditForm>
    </div>
}

@if (_categories is null)
{
    <LoadingIndicator />
}
else if (_categories.Count == 0)
{
    <EmptyState Icon="bi-tags" Title="No categories" Message="Create categories to classify your items." />
}
else
{
    <div class="panel">
        @foreach (var c in _categories)
        {
            <div class="tree-row">
                <span class="badge rounded-pill" style="background-color:@(c.Color ?? "#64748b")">&nbsp;</span>
                <span class="tree-name flex-grow-1">
                    @c.Name
                    @if (c.IsSystem) { <span class="badge text-bg-light ms-1">system</span> }
                    @if (c.IsArchived) { <span class="badge text-bg-dark ms-1">archived</span> }
                </span>
                <span class="text-secondary small me-3">@c.ItemCount item(s)</span>
                <AuthorizeView Policy="@Roles.CanEditPolicy">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="() => StartEdit(c)"><i class="bi bi-pencil"></i></button>
                        @if (c.IsArchived)
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => Restore(c)"><i class="bi bi-arrow-counterclockwise"></i></button>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => Archive(c)"><i class="bi bi-archive"></i></button>
                        }
                        @if (!c.IsSystem)
                        {
                            <button class="btn btn-outline-danger" @onclick="() => Delete(c)"><i class="bi bi-trash"></i></button>
                        }
                    </div>
                </AuthorizeView>
            </div>
        }
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private IReadOnlyList<CategoryDto>? _categories;
    private CategoryEditModel? _editing;
    private int? _editingId;
    private ConfirmDialog _confirm = default!;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _categories = await CategoryService.GetAllAsync(includeArchived: true);

    private void StartEdit(CategoryDto? c)
    {
        _editingId = c?.Id;
        _editing = c is null
            ? new CategoryEditModel { Color = "#0d9488" }
            : new CategoryEditModel { Name = c.Name, Description = c.Description, Color = c.Color, Icon = c.Icon };
    }

    private async Task Save()
    {
        var result = _editingId is null
            ? await CategoryService.CreateAsync(_editing!)
            : await CategoryService.UpdateAsync(_editingId.Value, _editing!);
        if (!result.Succeeded) { Toasts.Error(string.Join(" ", result.Errors)); return; }
        Toasts.Success("Category saved.");
        _editing = null;
        await Load();
    }

    private async Task Archive(CategoryDto c)
    {
        var r = await CategoryService.ArchiveAsync(c.Id);
        if (r.Succeeded) { Toasts.Info("Category archived."); await Load(); } else Toasts.Error(string.Join(" ", r.Errors));
    }

    private async Task Restore(CategoryDto c)
    {
        var r = await CategoryService.RestoreAsync(c.Id);
        if (r.Succeeded) { Toasts.Success("Category restored."); await Load(); } else Toasts.Error(string.Join(" ", r.Errors));
    }

    private async Task Delete(CategoryDto c)
    {
        if (!await _confirm.ShowAsync("Delete category", $"Delete “{c.Name}”? Items keep their data but lose this category.", "Delete")) return;
        var r = await CategoryService.DeleteAsync(c.Id);
        if (r.Succeeded) { Toasts.Success("Category deleted."); await Load(); } else Toasts.Error(string.Join(" ", r.Errors));
    }
}
