@page "/settings/users"
@attribute [Authorize(Policy = HomeStock.Domain.Enums.Roles.AdminPolicy)]
@rendermode InteractiveServer
@using HomeStock.Domain.Enums
@using HomeStock.Web.Infrastructure
@inject IUserAdminService UserAdmin
@inject ToastService Toasts

<PageTitle>Users · HomeStock</PageTitle>

<div class="page-header">
    <div>
        <a href="/settings" class="small text-secondary"><i class="bi bi-chevron-left"></i> Settings</a>
        <h1>Users &amp; roles</h1>
    </div>
    <button class="btn btn-primary" @onclick="() => _creating = !_creating"><i class="bi bi-person-plus"></i> New user</button>
</div>

<p class="text-secondary small">
    <strong>Administrator</strong> — full control · <strong>Standard user</strong> — create/edit items ·
    <strong>Read-only</strong> — view &amp; search only. Users with no role can view but not edit.
</p>

@if (_creating)
{
    <div class="panel mb-3">
        <h3 class="h6">New user</h3>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Email</label>
                <input class="form-control form-control-sm" @bind="_newEmail" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small mb-1">Password</label>
                <input type="password" class="form-control form-control-sm" @bind="_newPassword" />
            </div>
            <div class="col-8 col-md-3">
                <label class="form-label small mb-1">Role</label>
                <select class="form-select form-select-sm" @bind="_newRole">
                    @foreach (var r in Roles.All) { <option value="@r">@RoleLabel(r)</option> }
                </select>
            </div>
            <div class="col-4 col-md-2">
                <button class="btn btn-primary btn-sm w-100" @onclick="Create" disabled="@_busy">Create</button>
            </div>
        </div>
    </div>
}

@if (_users is null)
{
    <LoadingIndicator />
}
else
{
    <div class="panel">
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr><th>User</th>@foreach (var r in Roles.All) { <th class="text-center">@RoleLabel(r)</th> }<th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var u in _users)
                    {
                        <tr @key="u.Id">
                            <td>
                                <div>@u.Email @if (u.Id == _selfResetId) {}</div>
                                @if (!string.IsNullOrEmpty(u.DisplayName)) { <div class="small text-secondary">@u.DisplayName</div> }
                            </td>
                            @foreach (var r in Roles.All)
                            {
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" checked="@u.Roles.Contains(r)"
                                           @onchange="e => ToggleRole(u, r, (bool)e.Value!)" />
                                </td>
                            }
                            <td>
                                @if (u.IsLockedOut) { <span class="badge text-bg-secondary">Disabled</span> }
                                else { <span class="badge text-bg-success">Active</span> }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (u.IsLockedOut)
                                    {
                                        <button class="btn btn-outline-success" title="Enable" @onclick="() => SetActive(u, true)"><i class="bi bi-unlock"></i></button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary" title="Disable" @onclick="() => SetActive(u, false)"><i class="bi bi-lock"></i></button>
                                    }
                                    <button class="btn btn-outline-secondary" title="Reset password" @onclick="() => _resetFor = (_resetFor == u.Id ? null : u.Id)"><i class="bi bi-key"></i></button>
                                    <button class="btn btn-outline-danger" title="Delete" @onclick="() => Delete(u)"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                        @if (_resetFor == u.Id)
                        {
                            <tr>
                                <td colspan="@(Roles.All.Length + 3)">
                                    <div class="d-flex gap-2 align-items-center">
                                        <input type="password" class="form-control form-control-sm" style="max-width:16rem"
                                               placeholder="New password" @bind="_resetPassword" />
                                        <button class="btn btn-primary btn-sm" @onclick="() => ResetPassword(u)">Set password</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _resetFor = null">Cancel</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private IReadOnlyList<UserAdminDto>? _users;
    private bool _creating, _busy;
    private string? _newEmail, _newPassword;
    private string _newRole = Roles.StandardUser;
    private string? _resetFor, _resetPassword;
    private readonly string? _selfResetId = null;
    private ConfirmDialog _confirm = default!;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _users = await UserAdmin.GetUsersAsync();

    private async Task ToggleRole(UserAdminDto u, string role, bool inRole)
    {
        var r = await UserAdmin.SetRoleAsync(u.Id, role, inRole);
        if (!r.Succeeded) Toasts.Error(string.Join(" ", r.Errors));
        await Load();
    }

    private async Task SetActive(UserAdminDto u, bool active)
    {
        var r = await UserAdmin.SetActiveAsync(u.Id, active);
        if (r.Succeeded) Toasts.Success(active ? "User enabled." : "User disabled."); else Toasts.Error(string.Join(" ", r.Errors));
        await Load();
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_newEmail) || string.IsNullOrWhiteSpace(_newPassword))
        { Toasts.Warning("Enter an email and password."); return; }
        _busy = true;
        try
        {
            var r = await UserAdmin.CreateUserAsync(_newEmail!, _newPassword!, _newRole);
            if (!r.Succeeded) { Toasts.Error(string.Join(" ", r.Errors)); return; }
            Toasts.Success("User created.");
            _creating = false; _newEmail = _newPassword = null; _newRole = Roles.StandardUser;
            await Load();
        }
        finally { _busy = false; }
    }

    private async Task ResetPassword(UserAdminDto u)
    {
        if (string.IsNullOrWhiteSpace(_resetPassword)) { Toasts.Warning("Enter a new password."); return; }
        var r = await UserAdmin.ResetPasswordAsync(u.Id, _resetPassword!);
        if (r.Succeeded) { Toasts.Success("Password reset."); _resetFor = null; _resetPassword = null; }
        else Toasts.Error(string.Join(" ", r.Errors));
    }

    private async Task Delete(UserAdminDto u)
    {
        if (!await _confirm.ShowAsync("Delete user", $"Permanently delete {u.Email}? This cannot be undone.", "Delete")) return;
        var r = await UserAdmin.DeleteUserAsync(u.Id);
        if (r.Succeeded) { Toasts.Success("User deleted."); await Load(); } else Toasts.Error(string.Join(" ", r.Errors));
    }

    private static string RoleLabel(string role) => role switch
    {
        Roles.Administrator => "Admin",
        Roles.StandardUser => "Standard",
        Roles.ReadOnly => "Read-only",
        _ => role
    };
}
