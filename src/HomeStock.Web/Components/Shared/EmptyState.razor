@* Friendly empty-state message with optional icon and call-to-action. *@
<div class="empty-state">
    <i class="bi @Icon empty-state-icon"></i>
    <h3 class="empty-state-title">@Title</h3>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="empty-state-message">@Message</p>
    }
    @if (Action is not null)
    {
        <div class="empty-state-action">@Action</div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
}
