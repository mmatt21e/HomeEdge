@* Reusable confirmation modal. Call ShowAsync(...) and await the boolean result. *@

@if (_visible)
{
    <div class="app-modal-backdrop" @onclick="Cancel">
        <div class="app-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <h5 class="app-modal-title">@_title</h5>
            <p class="app-modal-body">@_message</p>
            <div class="app-modal-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@_cancelText</button>
                <button type="button" class="btn @(_danger ? "btn-danger" : "btn-primary")" @onclick="Confirm">@_confirmText</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible;
    private string _title = "";
    private string _message = "";
    private string _confirmText = "Confirm";
    private string _cancelText = "Cancel";
    private bool _danger;
    private TaskCompletionSource<bool>? _tcs;

    public Task<bool> ShowAsync(string title, string message, string confirmText = "Confirm",
        string cancelText = "Cancel", bool danger = true)
    {
        _title = title;
        _message = message;
        _confirmText = confirmText;
        _cancelText = cancelText;
        _danger = danger;
        _visible = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    private void Confirm() => Close(true);
    private void Cancel() => Close(false);

    private void Close(bool result)
    {
        _visible = false;
        _tcs?.TrySetResult(result);
        StateHasChanged();
    }
}
