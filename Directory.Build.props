<Project>
  <!--
    Shared build metadata for all HomeStock projects. The version can be overridden by CI at
    release time with: dotnet build /p:Version=1.2.3
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <Product>HomeStock</Product>
    <Company>HomeStock</Company>
    <Authors>HomeStock</Authors>
    <Description>Self-hosted home inventory application.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
